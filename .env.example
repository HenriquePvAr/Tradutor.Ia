SMART_PDF_MIN_HEIGHT=1050
SMART_PDF_MAX_HEIGHT=2400

# --- Comunidade / armazenamento privado dos PDFs publicados ---
# Provider de autenticacao: local (sessao loopback) ou supabase (JWT verificado por JWKS).
# Auth temporaria local: nenhuma sessao/admin e criada automaticamente.
COMMUNITY_AUTH_PROVIDER=local

# --- Supabase Auth (quando COMMUNITY_AUTH_PROVIDER=supabase) ---
# URL do projeto e chave publishable sao publicas (chegam ao browser). A secret key
# NUNCA vai para o frontend nem para o Git; use-a so em scripts administrativos locais.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Derivadas de SUPABASE_URL quando vazias; JWKS exige https.
SUPABASE_JWKS_URL=
SUPABASE_EXPECTED_ISSUER=
SUPABASE_EXPECTED_AUDIENCE=authenticated
SUPABASE_SITE_URL=http://127.0.0.1:8080
SUPABASE_REDIRECT_URL=http://127.0.0.1:8080/auth/callback
# Backend social: supabase (Data API + RLS, padrao) ou local (diferido, falha fechado).
# O backend usa apenas a publishable key + o JWT do usuario; nunca a secret/service_role.
COMMUNITY_SOCIAL_PROVIDER=supabase
# Bootstrap somente em localhost. Use um segredo aleatorio >=32 bytes fora do Git.
COMMUNITY_LOCAL_BOOTSTRAP_SECRET=
COMMUNITY_LOCAL_BOOTSTRAP_USER_ID=
# Roles confiaveis separadas por virgula (ex.: admin). Nunca sao aceitas do frontend.
COMMUNITY_LOCAL_BOOTSTRAP_ROLES=
COMMUNITY_LOCAL_SESSION_TTL_SECONDS=900
# O servidor permanece em loopback enquanto so houver auth local.
TRADUTOR_UI_HOST=127.0.0.1
TRADUTOR_ALLOW_EXTERNAL_BIND=0
# Provider de storage: filesystem (padrao local, privado em .cache) ou google_drive.
COMMUNITY_STORAGE_PROVIDER=filesystem
# ID da pasta raiz no Meu Drive onde os PDFs publicados serao guardados (privados).
# Crie a pasta pelo app: python drive_auth.py create-root-folder
COMMUNITY_DRIVE_ROOT_FOLDER_ID=
# Credenciais OAuth 2.0 (tipo Desktop app) da conta administradora. NUNCA comitar valores reais.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Caminho do arquivo de token fora do repositorio (escrita atomica, permissao restrita).
GOOGLE_OAUTH_TOKEN_PATH=
# Escopo OAuth (opcional). Padrao: drive.file (menor privilegio). Nao ampliar sem necessidade.
GOOGLE_OAUTH_SCOPES=

# Navegador isolado usado somente na análise segura da fonte.
TRADUTOR_ALLOW_DRIVER_DOWNLOAD=0
SOURCE_BROWSER_ENGINE=
SOURCE_BROWSER_EXECUTABLE=
SOURCE_BROWSER_HEADLESS=1
SOURCE_BROWSER_STARTUP_TIMEOUT=30
SOURCE_BROWSER_NAVIGATION_TIMEOUT=45
SOURCE_BROWSER_PROFILE_MODE=temporary
