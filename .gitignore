.env
.env.local
.venv/
# Clean-room environment built from requirements-beta.txt to validate the Beta runtime.
.venv-beta/
**pycache**/
__pycache__/
pycache/
*.pyc
*.py[cod]

capitulo_temp/
capitulo_temp_out/
*_out/
debug/
output/
temp/
tmp/
downloads/
models/
.paddlex/
.paddleocr/
.cache/
.runtime/

*.pdf
*.png
*.jpg
*.jpeg
*.webp
!static/assets/
!static/assets/reference-ui/
!static/assets/reference-ui/*.jpg
# Documentation assets: screenshots for docs/user/GUIA_DO_USUARIO.md must be versionable.
!docs/assets/
!docs/assets/**
*.log

.pytest_cache/
.mypy_cache/
.ruff_cache/
.playwright-cli/

# Packaging output and alternative virtualenv layouts.
build/
dist/
*.egg-info/
venv/
env/

# Crash and trace dumps left behind by Chrome/Crashpad and Windows ETW sessions.
*.dmp
*.etl

# Local audit outputs remain in private local storage. Authoritative
# documentation belongs under docs/; artifacts/ is not part of the product
# source tree.
artifacts/
artifacts/audit/*.log
artifacts/audit/*-manifest.csv
artifacts/audit/runtime/*.log
artifacts/generated/
artifacts/outputs/
artifacts/diagnostics/

# Local performance/release outputs (the source repo keeps tooling, not runs).
performance_outputs/
diagnostics_outputs/
snapshots/

# Personal IDE state.
.idea/
.vscode/

# Private key material must never reach a commit. The release signing key lives OUTSIDE this
# repository (see scripts/sign_release.py); this is only a guard against an accidental copy.
*.pem
*.key
*.pk8
